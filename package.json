{
  "name": "@zenginehq/mayan",
  "version": "3.0.0",
  "main": "cli.js",
  "bin": {
    "mayan": "cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "mocha --require test/support/chai.js --exit",
    "tdd": "mocha --require test/support/chai.js --watch",
    "eslint": "eslint lib/ cmds/ test/",
    "release": "npm run eslint && npm run build && release-it"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZengineHQ/mayan.git"
  },
  "dependencies": {
    "@babel/core": "^7.10.5",
    "@babel/plugin-proposal-object-rest-spread": "^7.10.4",
    "@babel/plugin-transform-strict-mode": "^7.10.4",
    "@babel/preset-env": "^7.10.4",
    "@ngrok/ngrok": "^1.7.0",
    "archiver": "^7.0.1",
    "bluebird": "^3.7.2",
    "callbag-combine": "^1.2.0",
    "callbag-debounce": "^4.0.0",
    "callbag-for-each": "^1.1.0",
    "callbag-pipe": "^1.2.0",
    "chokidar": "^3.4.1",
    "clipboardy": "^5.3.2",
    "compare-versions": "^6.1.0",
    "execa": "^10.0.1",
    "gulp": "^4.0.2",
    "gulp-babel": "^8.0.0",
    "gulp-concat": "^2.6.1",
    "gulp-html-minifier-terser": "^8.0.0",
    "gulp-replace": "^1.0.0",
    "gulp-sass": "^6.0.1",
    "gulp-terser": "^2.1.0",
    "http-proxy": "^1.18.1",
    "kleur": "^4.1.5",
    "listr": "^0.14.3",
    "lodash": "^4.18.1",
    "pump": "^3.0.0",
    "sass": "^1.104.1",
    "tree-kill": "^1.2.2",
    "update-notifier": "^7.3.1",
    "yargs": "^17.7.3"
  },
  "devDependencies": {
    "auto-changelog": "^2.4.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^7.3.0",
    "mocha": "^12.0.1",
    "release-it": "^21.0.3"
  },
  "release-it": {
    "github": {
      "release": true
    }
  },
  "git": {
    "changelog": "npx auto-changelog --stdout --commit-limit false --unreleased --template https://raw.githubusercontent.com/release-it/release-it/master/templates/changelog-compact.hbs"
  },
  "hooks": {
    "after:bump": "npx auto-changelog -p"
  },
  "overrides": {
    "lodash": "^4.18.1"
  }
}
